# Copy to .env and adjust for your environment.

# Bind (container/public reverse-proxy usually 0.0.0.0)
DICOMFLOW_HOST=127.0.0.1
DICOMFLOW_PORT=8765

# REQUIRED before public internet exposure
DICOMFLOW_ACCESS_TOKEN=change-me-to-a-long-random-secret

# Optional human verification (Cloudflare Turnstile) — independent of access password
# Get keys: https://dash.cloudflare.com/?to=/:account/turnstile
DICOMFLOW_CAPTCHA_ENABLED=false
# DICOMFLOW_TURNSTILE_SITE_KEY=0x4AAAA...
# Canonical secret name (preferred). Never commit the real value.
# TURNSTILE_SECRET=
# Legacy alias still accepted: DICOMFLOW_TURNSTILE_SECRET_KEY

# Never enable on the public internet unless you intend to expose API schema
DICOMFLOW_ENABLE_DOCS=false

# Comma-separated hosts (production domain). Use * only behind a private network.
# DICOMFLOW_ALLOWED_HOSTS=dicomflow.example.com,localhost

# Leave empty for same-origin only (recommended)
# DICOMFLOW_CORS_ORIGINS=

# Upload / rate limits
DICOMFLOW_MAX_UPLOAD_BYTES=1073741824
DICOMFLOW_RATE_LIMIT_RPM=120
DICOMFLOW_RATE_LIMIT_UPLOADS_PER_HOUR=20
# Chunk part RPM (higher so multi-hundred-MB files are not blocked mid-stream)
DICOMFLOW_RATE_LIMIT_CHUNK_RPM=300
# Job status poll GET /jobs/{id} (SPA polls during convert; separate from global RPM)
DICOMFLOW_RATE_LIMIT_JOB_POLL_RPM=180

# Chunked upload — enable behind Cloudflare Tunnel / reverse proxies with ~100MB body limits
# false = single-shot POST /api/v1/uploads only (default)
# true  = SPA uses init + PUT parts + complete (recommended for public CF Zero Trust)
DICOMFLOW_CHUNKED_UPLOAD_ENABLED=false
# Part size in megabytes (default 4; range 1–90). CF Free ~100s timeout → keep small on slow uplinks.
DICOMFLOW_CHUNK_SIZE_MB=4
DICOMFLOW_MAX_UPLOAD_CHUNKS=512

# Only enable behind a trusted reverse proxy that sets X-Forwarded-For
DICOMFLOW_TRUST_X_FORWARDED_FOR=false

DICOMFLOW_DATA_DIR=./data
DICOMFLOW_WORKERS=1

# Auto-delete uploads + conversion outputs after N hours (default 24)
DICOMFLOW_JOB_TTL_HOURS=24
# Background cleaner interval (seconds)
DICOMFLOW_CLEANUP_INTERVAL_SECONDS=900
