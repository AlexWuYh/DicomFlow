# DicomFlow — 中国内地构建优化版
# 与 Dockerfile 功能一致，但默认全部走国内镜像，避免 Docker Hub / deb.debian.org /
# pypi.org / rarlab 跨境超时。
#
# 构建示例：
#   docker build -f Dockerfile.cn -t dicomflow:local-cn .
#   docker compose -f docker-compose.yml -f docker-compose.build.cn.yml up -d --build
#
# 可覆盖基础镜像（默认 DaoCloud Docker Hub 代理）：
#   docker build -f Dockerfile.cn \
#     --build-arg PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.12-slim-bookworm \
#     -t dicomflow:local-cn .

# ── 基础镜像（Docker Hub 国内代理，可改 ARG）────────────────
# 其它常见选项：
#   dockerproxy.com/library/python:3.12-slim-bookworm
#   registry.cn-hangzhou.aliyuncs.com/...（若自建同步）
ARG PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.12-slim-bookworm
FROM ${PYTHON_IMAGE}

# ── 国内 pip 源（清华 TUNA）────────────────────────────────
# 也可构建时覆盖：--build-arg PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
ARG PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_INDEX_URL=${PIP_INDEX_URL} \
    PIP_TRUSTED_HOST=${PIP_TRUSTED_HOST} \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DICOMFLOW_HOST=0.0.0.0 \
    DICOMFLOW_PORT=8765 \
    DICOMFLOW_DATA_DIR=/data \
    DICOMFLOW_WEB_DIR=/app/web \
    DICOMFLOW_ENABLE_DOCS=false

# ── Debian apt → 阿里云（Bookworm deb822 + 旧版 sources.list 均处理）──
RUN set -eux; \
    if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
      sed -i \
        -e 's|https\?://deb.debian.org|http://mirrors.aliyun.com|g' \
        -e 's|https\?://security.debian.org|http://mirrors.aliyun.com/debian-security|g' \
        /etc/apt/sources.list.d/debian.sources; \
    fi; \
    if [ -f /etc/apt/sources.list ]; then \
      sed -i \
        -e 's|https\?://deb.debian.org|http://mirrors.aliyun.com|g' \
        -e 's|https\?://security.debian.org|http://mirrors.aliyun.com/debian-security|g' \
        /etc/apt/sources.list; \
    fi; \
    # 若镜像源文件为空/异常，写入阿里云 bookworm 源兜底
    if ! grep -qrE 'mirrors\.aliyun\.com|deb\.debian\.org' /etc/apt/sources.list /etc/apt/sources.list.d 2>/dev/null; then \
      printf '%s\n' \
        'deb http://mirrors.aliyun.com/debian bookworm main contrib non-free non-free-firmware' \
        'deb http://mirrors.aliyun.com/debian bookworm-updates main contrib non-free non-free-firmware' \
        'deb http://mirrors.aliyun.com/debian-security bookworm-security main contrib non-free non-free-firmware' \
        > /etc/apt/sources.list; \
    fi

# 系统依赖（全部来自上面配置的 apt 镜像）
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      ffmpeg \
      p7zip-full \
      unrar-free \
    && rm -rf /var/lib/apt/lists/*

# 官方 unrar（RAR5，amd64）。rarlab 在国内常慢/超时：
# - 优先短超时拉取；失败则仅用 apt 的 unrar-free（多数 rar 仍可用）
# - 也可自行把 rarlinux 包放到构建上下文后改 COPY 安装
RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    if [ "$arch" = "amd64" ]; then \
      if curl -fsSL --connect-timeout 8 --max-time 60 \
          -o /tmp/rar.tar.gz \
          https://www.rarlab.com/rar/rarlinux-x64-701.tar.gz; then \
        tar -xzf /tmp/rar.tar.gz -C /tmp; \
        install -m 755 /tmp/rar/unrar /usr/local/bin/unrar; \
        rm -rf /tmp/rar /tmp/rar.tar.gz; \
      else \
        echo "WARN: rarlab unreachable; using unrar-free from apt only" >&2; \
      fi; \
    fi; \
    (command -v unrar && unrar 2>&1 | head -1) \
      || (command -v unrar-free && unrar-free 2>&1 | head -1) \
      || true

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src ./src
COPY web ./web

# pip 使用 ENV 中的国内 index（无需再写 -i，便于缓存层一致）
RUN pip install --upgrade pip \
    && pip install --no-cache-dir .

RUN mkdir -p /data/uploads /data/work /data/outputs \
    && useradd --create-home --shell /bin/bash dicomflow \
    && chown -R dicomflow:dicomflow /data /app

USER dicomflow
EXPOSE 8765
VOLUME ["/data"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -fsS "http://127.0.0.1:${DICOMFLOW_PORT}/health" || exit 1

CMD ["dicomflow", "serve", "--host", "0.0.0.0", "--port", "8765"]
